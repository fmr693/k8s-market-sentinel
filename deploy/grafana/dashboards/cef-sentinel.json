          "rawSql": "SELECT obs_date::timestamptz AS \"time\",\n       value AS \"Baa - 10Y spread\",\n       (SELECT value FROM silver.macro_series\n         WHERE series_id = 'BAA10Y'\n         ORDER BY obs_date DESC LIMIT 1) AS \"Today\"\n  FROM silver.macro_series\n WHERE series_id = 'BAA10Y'\n   AND $__timeFilter(obs_date::timestamptz)\n ORDER BY 1"
